[global]
    # Display
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 10x10
    width = (200, 400)
    height = 300
    notification_limit = 5

    # Progress bar
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1

    # Appearance
    transparency = 10
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#3a494f"
    separator_color = frame
    corner_radius = 5
    gap_size = 4

    # Font
    font = JetBrains Mono Nerd Font 11

    # Text
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Icons
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    # History
    sticky_history = yes
    history_length = 20

    # Misc
    sort = yes
    idle_threshold = 120
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#192124"
    foreground = "#849399"
    frame_color = "#3a494f"
    timeout = 5

[urgency_normal]
    background = "#232b2e"
    foreground = "#dbe4e8"
    frame_color = "#ebc161"
    timeout = 10

[urgency_critical]
    background = "#93000a"
    foreground = "#ffdad6"
    frame_color = "#ffb4ab"
    timeout = 0
